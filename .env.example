# StudyMaze Environment Configuration Example
# Copy to .env and adjust credentials if needed

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=studymaze
DB_USER=root
DB_PASS=

# SMTP Email Configuration (for password reset & email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM=noreply@studymaze.local
MAIL_FROM_NAME="StudyMaze"
